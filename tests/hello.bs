// BanglaScript integration test
ধরি নাম = "বাংলা";

ফাংশন অভিবাদন(ব্যক্তি) {
    ফেরত ব্যক্তি + " ভাষায় প্রোগ্রামিং!";
}

দেখাও অভিবাদন(নাম);

ধরি সংখ্যা = 1;
যতক্ষণ (সংখ্যা <= 5) {
    যদি (সংখ্যা % 2 == 0) {
        দেখাও "জোড়", সংখ্যা;
    } নাহলে {
        দেখাও "বিজোড়", সংখ্যা;
    }
    সংখ্যা = সংখ্যা + 1;
}
